# Copy to .env (gitignored) and fill in. Never commit real values.

# Index pool: rag_dev (development, default) or rag (prod). Also the Elasticsearch username.
RAG_ENV_PREFIX=rag_dev

# Elasticsearch (the shared stack is plain HTTP on loopback)
ES_URL=http://127.0.0.1:9200
ES_PASSWORD=

# Ollama (embedding)
OLLAMA_URL=http://127.0.0.1:11434

# Generation and judge (DeepSeek)
DEEPSEEK_API_KEY=

# API keys mapped to principals in rag.security.api-keys (ROADMAP §3.1).
# Clearances are ordered public < internal < restricted. The audit endpoints need the admin role;
# issue its key at restricted clearance (an operations key).
RAG_KEY_DEV=
RAG_KEY_INTERNAL=
RAG_KEY_PUBLIC=
RAG_KEY_ADMIN=

# Audit read/replay uses a separate read-only Elasticsearch user. Blank disables GET/replay with 503.
ES_AUDIT_READER_USERNAME=
ES_AUDIT_READER_PASSWORD=
# Blank = audit-<RAG_ENV_PREFIX>-v1.
# RAG_AUDIT_INDEX=

# Management endpoint (Prometheus, health). Loopback by default; the development server sets
# MANAGEMENT_ADDRESS=0.0.0.0 and relies on the host firewall to allow only the Docker proxy subnet.
MANAGEMENT_PORT=8081
MANAGEMENT_ADDRESS=127.0.0.1
OTLP_ENDPOINT=http://127.0.0.1:30117/v1/traces
OTLP_SAMPLE_RATE=1.0

# CI gate only: use committed fixtures instead of Ollama (see scripts/build-fixture.sh).
# RAG_FIXTURE_DIR=eval/fixtures/<corpusVersion>-ollama_nomic-embed-text-structural-v1-400-cl100k

# Phase 2 experiments: pick one embedding model (nomic | bge-small | bge-m3) and optionally one physical
# index per process. Blank index = the alias. scripts/run-ablation.sh sets these itself.
# RAG_EMBEDDING_MODEL=nomic
# RAG_CHUNKS_INDEX=
# RAG_SECTIONS_INDEX=
